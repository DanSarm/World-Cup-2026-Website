NEXT_PUBLIC_SITE_NAME="Family Cup 2026"
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
SESSION_SECRET=your_random_32_char_secret_minimum
FAMILY_ACCESS_CODE=your_family_code
ADMIN_INVITE_CODE=your_admin_code

# The Odds API (optional — bonus points still work with manual admin entry)
# Free tier = 500 credits/month. Keep ODDS_REGIONS=us (1 credit per odds call).
ODDS_API_KEY=
ODDS_API_PROVIDER=the_odds_api
ODDS_REGIONS=us
ODDS_WINNER_REGIONS=us
ODDS_MARKETS=h2h
ODDS_FORMAT=decimal
ODDS_LOCK_HOURS_BEFORE_KICKOFF=1
ODDS_SPORT_KEY=soccer_fifa_world_cup
ODDS_WINNER_SPORT_KEY=soccer_fifa_world_cup_winner
CRON_SECRET=

# Live scores — conservative defaults for free tier (~8 API calls/day max during matches)
LIVE_SCORES_ENABLED=true
LIVE_SCORES_MIN_INTERVAL_MS=600000
LIVE_SCORES_MAX_SYNCS_PER_DAY=8
ODDS_API_MIN_CREDITS_RESERVE=40
NEXT_PUBLIC_LIVE_POLL_INTERVAL_MS=600000
